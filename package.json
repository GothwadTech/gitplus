{
  "name": "gitplus",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run test && npm run build && npm run pages:check",
    "pages:dev": "wrangler pages dev dist --ip 0.0.0.0 --port 8788",
    "pages:check": "wrangler pages functions build functions --outdir .wrangler/functions-build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "GitPlus — a Gothwad Tech product with Gothwad Accounts SSO and GitHub repository tools.",
  "overrides": {
    "undici": "^7.30.1"
  }
}
